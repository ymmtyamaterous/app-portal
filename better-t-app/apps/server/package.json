{
	"name": "server",
	"type": "module",
	"main": "src/index.ts",
	"scripts": {
		"build": "tsdown",
		"check-types": "tsc -b",
		"compile": "bun build --compile --minify --sourcemap --bytecode ./src/index.ts --outfile server",
		"dev": "bun run --hot src/index.ts",
		"seed-admin": "bun run src/seed-admin.ts",
		"cleanup-access-logs": "bun run src/cleanup-access-logs.ts",
		"start": "bun run dist/index.mjs"
	},
	"dependencies": {
		"@better-t-app/api": "workspace:*",
		"@better-t-app/auth": "workspace:*",
		"@better-t-app/db": "workspace:*",
		"@better-t-app/env": "workspace:*",
		"@orpc/openapi": "catalog:",
		"@orpc/server": "catalog:",
		"@orpc/zod": "catalog:",
		"better-auth": "catalog:",
		"dotenv": "catalog:",
		"drizzle-orm": "catalog:",
		"hono": "catalog:",
		"libsql": "catalog:",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@better-t-app/config": "workspace:*",
		"@types/bun": "catalog:",
		"tsdown": "^0.22.14",
		"typescript": "catalog:"
	}
}
