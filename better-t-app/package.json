{
	"name": "better-t-app",
	"private": true,
	"workspaces": {
		"packages": [
			"apps/*",
			"packages/*"
		],
		"catalog": {
			"dotenv": "^17.4.2",
			"zod": "^4.4.3",
			"typescript": "^6.0.3",
			"@types/bun": "^1.4.0",
			"libsql": "0.5.29",
			"hono": "^4.12.32",
			"@orpc/server": "^1.14.12",
			"@orpc/openapi": "^1.14.12",
			"@orpc/zod": "^1.14.12",
			"better-auth": "1.7.1",
			"drizzle-orm": "^0.45.2",
			"lucide-react": "^1.27.0",
			"next-themes": "^0.4.6",
			"react": "^19.2.8",
			"react-dom": "^19.2.8",
			"sonner": "^2.0.7",
			"@orpc/client": "^1.14.12",
			"@types/react": "^19.2.17",
			"@types/react-dom": "^19.2.3",
			"tailwindcss": "^4.3.3"
		}
	},
	"type": "module",
	"scripts": {
		"dev": "turbo run dev",
		"build": "turbo run build",
		"check-types": "turbo run check-types",
		"dev:web": "turbo run dev -F web --",
		"dev:server": "turbo run dev -F server --",
		"db:push": "turbo run db:push -F @better-t-app/db --",
		"db:studio": "turbo run db:studio -F @better-t-app/db --",
		"db:generate": "turbo run db:generate -F @better-t-app/db --",
		"db:migrate": "turbo run db:migrate -F @better-t-app/db --",
		"db:local": "turbo run db:local -F @better-t-app/db --",
		"seed-admin": "turbo run seed-admin -F server --",
		"cleanup-access-logs": "turbo run cleanup-access-logs -F server --",
		"test": "bun test",
		"check": "biome check --write ."
	},
	"dependencies": {
		"@better-t-app/env": "workspace:*",
		"dotenv": "catalog:",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@better-t-app/config": "workspace:*",
		"@biomejs/biome": "^2.5.11",
		"@types/bun": "catalog:",
		"drizzle-orm": "catalog:",
		"lefthook": "^2.1.12",
		"turbo": "^2.10.12",
		"typescript": "catalog:"
	},
	"packageManager": "bun@1.3.13"
}
